{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sonnenhain Quest",
  "type": "object",
  "required": ["id", "type", "title", "region", "giver", "summary", "dialogue", "objectives", "rewards"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "type": { "enum": ["heart", "story"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 40 },
    "region": { "type": "string" },
    "giver": { "type": "string" },
    "summary": { "type": "string", "maxLength": 160 },
    "dialogue": {
      "type": "object",
      "required": ["intro", "done"],
      "properties": {
        "intro": { "type": "string" },
        "progress": { "type": "string" },
        "done": { "type": "string" }
      },
      "additionalProperties": false
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "target", "label"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["defeat", "collect", "talk"] },
          "target": { "type": "string" },
          "label": { "type": "string", "maxLength": 60 },
          "points": { "type": "number", "minimum": 1, "maximum": 100 },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "rewards": {
      "type": "object",
      "required": ["xp"],
      "properties": { "xp": { "type": "integer", "minimum": 0 } },
      "additionalProperties": true
    }
  }
}
